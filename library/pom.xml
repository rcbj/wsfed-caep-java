<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- The library alone: this pom inherits nothing, so it is complete as published.
       The demo is the sibling module ../demo, which is never published. -->
  <groupId>com.iyasec</groupId>
  <artifactId>wsfed-caep</artifactId>
  <version>0.1.0</version>
  <name>wsfed-caep</name>
  <description>Server-side WS-Federation relying party that accepts SAML 2.0 assertions, and a CAEP and RISC receiver.</description>
  <url>https://github.com/rcbj/wsfed-caep-java</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>rcbjBlueMars</id>
      <name>Robert C. Broeckelmann Jr.</name>
      <organization>Iya CyberSecurity Solutions, LLC</organization>
      <organizationUrl>https://github.com/rcbj</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/rcbj/wsfed-caep-java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/rcbj/wsfed-caep-java.git</developerConnection>
    <url>https://github.com/rcbj/wsfed-caep-java</url>
  </scm>
  <properties>
    <!-- true builds the bundle Central would receive, signed, and uploads nothing. -->
    <central.skipPublishing>false</central.skipPublishing>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.apache.santuario</groupId>
      <artifactId>xmlsec</artifactId>
      <version>2.3.4</version>
    </dependency>
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>9.40</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.1</version>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>2.22.2</version>
      </plugin>
      <plugin>
        <!-- StubIdp and its key files: test fixtures this module's tests and the demo's share.
             They are compiled into the test classpaths only, never into a published jar. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>test-fixtures</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal><goal>add-test-resource</goal></goals>
            <configuration>
              <sources><source>${project.basedir}/src/test-fixtures/java</source></sources>
              <resources><resource><directory>${project.basedir}/src/test-fixtures/resources</directory></resource></resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- mvn -Prelease deploy: what publish.yml runs, and only on this module. The tests,
         the demo and the image never use this profile and never need the signing key.
         Central requires the sources and javadoc jars, a signature on every file
         (the gpg plugin's Bouncy Castle signer reads MAVEN_GPG_KEY and
         MAVEN_GPG_PASSPHRASE, so no gpg program or agent is needed), and checksums,
         which the publishing plugin writes. The Central Portal user token is the
         server "central" in settings.xml. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <!-- Missing comments are not errors; malformed ones still are. -->
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <configuration>
              <signer>bc</signer>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <skipPublishing>${central.skipPublishing}</skipPublishing>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
